---
import { ClientRouter } from 'astro:transitions';
import '../styles/global.css';

interface Props {
	title: string;
	description?: string;
}

const {
	title,
	description = 'Portfolio de Digital Designer — projets, approche et contact.',
} = Astro.props;
---

<!doctype html>
<html lang="fr" transition:animate="none">
	<head>
		<meta charset="utf-8" />
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<meta name="viewport" content="width=device-width" />
		<meta name="generator" content={Astro.generator} />
		<meta name="description" content={description} />
		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			href="https://fonts.googleapis.com/css2?family=Inter+Tight:wght@400;500;600;700&display=swap"
			rel="stylesheet"
		/>
		<title>{title}</title>
		<ClientRouter />
	</head>
	<body>
		<a
			class="folio__brand site-brand"
			href="/"
			aria-label="Edgar — retour aux projets"
			transition:persist="site-brand"
		>
			Edgar
		</a>
		<slot />
		<script>
			function dedupeSiteBrand() {
				const brands = [...document.querySelectorAll<HTMLAnchorElement>('.site-brand')];
				if (brands.length <= 1) return;
				const kept =
					brands.find((el) => el.dataset.bound === '1') ?? brands[0];
				brands.forEach((el) => {
					if (el !== kept) el.remove();
				});
			}

			function bindSiteBrand() {
				dedupeSiteBrand();
				const brand = document.querySelector<HTMLAnchorElement>('.site-brand');
				if (!brand) return;
				if (brand.dataset.bound === '1') return;
				brand.dataset.bound = '1';
				brand.addEventListener('click', (event) => {
					const path = window.location.pathname.replace(/\/$/, '') || '/';
					if (path === '/') {
						event.preventDefault();
						window.dispatchEvent(new CustomEvent('folio:home'));
					}
				});
			}

			bindSiteBrand();
			document.addEventListener('astro:after-swap', () => {
				dedupeSiteBrand();
				bindSiteBrand();
			});
			document.addEventListener('astro:page-load', bindSiteBrand);
		</script>
	</body>
</html>
