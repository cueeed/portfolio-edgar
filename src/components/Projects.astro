---
import { getHomepageProjects } from '../lib/projects';

const projects = await getHomepageProjects();
const total = projects.length;
const columnCount = 3;

const columns = Array.from({ length: columnCount }, () => [] as typeof projects);

projects.forEach((project) => {
	columns[project.index % columnCount].push(project);
});
---

<section class="section section--projects" id="projets">
	<header class="projects-header">
		<p class="projects-intro">
			J’aime créer des solutions innovantes qui répondent à un besoin précis.
			Car chaque client mérite d’être accompagné.
		</p>
		<h2 class="projects-heading">Projets ({total})</h2>
	</header>

	{
		total === 0 ? (
			<p class="projects-empty">
				Aucun projet publié pour le moment. Lance le Studio (
				<code>cd studio && npm run dev</code>
				) pour en créer.
			</p>
		) : (
			<div class="projects-masonry">
				{columns.map((column, colIndex) => (
					<div class={`projects-col projects-col--${colIndex + 1}`}>
						{column.map((project) => (
							<a
								class="project-card"
								href={project.href}
								style={`--order: ${project.index}`}
							>
								<div class="project-card__media">
									<img
										src={project.coverImageUrl}
										alt={project.coverAlt}
										loading="lazy"
										width="900"
										height="1350"
									/>
								</div>
								<p class="project-card__caption">
									<span class="project-card__name">{project.title}</span>
									<span class="project-card__sep" aria-hidden="true">
										{' '}
										·{' '}
									</span>
									<span class="project-card__tagline">
										{project.client} — {project.categoryLabel}
									</span>
								</p>
							</a>
						))}
					</div>
				))}
			</div>
		)
	}

	<p class="projects-aside">
		Chaque projet a été réalisé dans le cadre de mon poste chez Publipresse.
	</p>
</section>
