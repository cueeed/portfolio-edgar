---
interface Props {
	text: string;
	class?: string;
	href: string;
	style?: string;
	'aria-label'?: string;
}

const {
	text,
	class: className = '',
	href,
	style,
	'aria-label': ariaLabel,
} = Astro.props;

const chars = [...text];
---

<a
	class:list={['mask-text', className]}
	href={href}
	style={style}
	aria-label={ariaLabel ?? text}
	data-mask-ready="1"
>
	{
		chars.map((char, index) => (
			<span class="mask-text__char" style={`--i: ${index}`} aria-hidden="true">
				<span class="mask-text__inner">{char === ' ' ? '\u00A0' : char}</span>
			</span>
		))
	}
</a>
