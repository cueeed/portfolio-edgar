# Variables publiques (sûres côté client / build Netlify)
PUBLIC_SANITY_PROJECT_ID=j2h3fv1f
PUBLIC_SANITY_DATASET=production

# Ne jamais préfixer un token avec PUBLIC_
# SANITY_API_READ_TOKEN=...  # seulement si Visual Editing / drafts plus tard

# Build Hook Netlify — bouton « Mettre en ligne » dans Sanity Studio
# Site settings → Build & deploy → Build hooks → Add build hook
# SANITY_STUDIO_NETLIFY_BUILD_HOOK=https://api.netlify.com/build_hooks/xxxxxxxx
